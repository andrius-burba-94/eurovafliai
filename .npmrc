# Enforce the Node version pinned in .nvmrc and package.json `engines`.
#
# Without this, npm only *warns* when you install on the wrong Node, so a repo
# can be pinned to 24 and still be developed on 22 for months — which is how
# "works on my machine" starts. With it, `npm install` / `npm ci` refuse to run
# and say which version they wanted.
#
# CI reads .nvmrc (actions/setup-node `node-version-file`), so it always matches.
# Locally, fnm or nvm reads the same file: `fnm use` / `nvm use` in the repo root.
engine-strict=true
