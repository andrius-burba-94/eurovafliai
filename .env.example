# Eurovafliai — environment template.
#
# Copy to `.env` for local dev (`cp .env.example .env`) and fill in the blanks.
# `.env` is gitignored; this file is the committed source of truth for WHAT
# variables exist. Add a variable here in the same PR that starts reading it.
# Never commit real secrets, and never log env values.

# --- PocketBase ------------------------------------------------------------
# Browser-facing base URL. Locally this is the dev server directly; in
# production it is the Nginx-proxied path, because 8095 is bound to localhost.
#   production: https://eurovafliai.labrium.online/pb
NEXT_PUBLIC_PB_URL=http://127.0.0.1:8095

# Server-side (Next server actions + the worker) talk to PocketBase directly.
PB_INTERNAL_URL=http://127.0.0.1:8095

# Superuser used by server actions for engine-owned writes. Create it once with:
#   ./pb/pocketbase superuser upsert <email> <password> --dir=pb/pb_data
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Google OAuth2 ---------------------------------------------------------
# One Google Cloud OAuth client, two authorized redirect URIs:
#   http://localhost:3007/auth/callback
#   https://eurovafliai.labrium.online/auth/callback
# The same values are also configured on PocketBase's `users` auth provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session ---------------------------------------------------------------
# Name of the httpOnly cookie holding the PocketBase auth token.
SESSION_COOKIE_NAME=eurovafliai_session
